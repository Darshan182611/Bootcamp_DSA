question 4:Can Place Flowers(lc-605)
solution: class Solution {
    public boolean canPlaceFlowers(int[] flowerbed, int n) {
        // Base case: If no flowers need to be planted, it's always possible.
        if (n <= 0) {
            return true;
        }
        
        int length = flowerbed.length;
        
        for (int i = 0; i < length; i++) {
            // Check if the current plot is empty
            if (flowerbed[i] == 0) {
                // Check if the left neighbor is empty or if we are at the first plot
                boolean isLeftEmpty = (i == 0) || (flowerbed[i - 1] == 0);
                
                // Check if the right neighbor is empty or if we are at the last plot
                boolean isRightEmpty = (i == length - 1) || (flowerbed[i + 1] == 0);
                
                // If both conditions are satisfied, we can plant a flower
                if (isLeftEmpty && isRightEmpty) {
                    flowerbed[i] = 1; // Modify the array to place the flower
                    n--;              // Reduce the remaining flowers count
                    
                    // Optimization: Early exit if all flowers are successfully placed
                    if (n == 0) {
                        return true;
                    }
                }
            }
        }
        
        // Return true if all flowers were placed, false otherwise
        return n <= 0;
    }
}

question 5: Reverse Vowels of a String(lc-345)
solution: class Solution {
            public static String reverseVowels(String s) {
        // Step 1: Track vowels in a temporary storage collection
        List<Character> vowelsList = new ArrayList<>();
        
        // Step 2: First pass to collect all vowels from the string
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (isVowel(ch)) {
                vowelsList.add(ch);
            }
        }
        
        // Step 3: Rebuild the string using a helper pointer from the back of the list
        StringBuilder result = new StringBuilder();
        int vowelIndex = vowelsList.size() - 1; // Start from the last collected vowel
        
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            if (isVowel(ch)) {
                // Replace with the vowel from the end of the collection
                result.append(vowelsList.get(vowelIndex));
                vowelIndex--;
            } else {
                // Keep non-vowel characters exactly as they are
                result.append(ch);
            }
        }
        
        return result.toString();
    }

    // Helper method to check for both lowercase and uppercase vowels
    private static boolean isVowel(char ch) {
        return ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u' ||
               ch == 'A' || ch == 'E' || ch == 'I' || ch == 'O' || ch == 'U';
    }

    public static void main(String[] args) {
        String input = "hello";
        System.out.println("Original: " + input);
        System.out.println("Reversed Vowels: " + reverseVowels(input)); // Output: holle
    }
}


QUESTION FROM HACKERRANK :
Java Exception Handling:
solution: rt java.util.Scanner;
class MyCalculator {
    long power(int n, int p) throws Exception {
        if (n < 0 || p < 0) {
            throw new Exception("n or p should not be negative.");
        }
        if (n == 0 && p == 0) {
            throw new Exception("n and p should not be zero.");
        }
        return (long) Math.pow(n, p);
    }
}
    
public class Solution {
    public static final MyCalculator my_calculator = new MyCalculator();
    public static final Scanner in = new Scanner(System.in);
    
    public static void main(String[] args) {
        while (in .hasNextInt()) {
            int n = in .nextInt();
            int p = in .nextInt();
            
            try {
                System.out.println(my_calculator.power(n, p));
            } catch (Exception e) {
                System.out.println(e);
            }
        }
    }
}
