question 1:Merge Strings Alternately(lc-1768)
  solution: class Solution {
    public String mergeAlternately(String word1, String word2) {
        StringBuilder result = new StringBuilder();
        
        // Find the maximum length to ensure all characters are processed
        int maxLength = Math.max(word1.length(), word2.length());
        
        // Loop through every index up to the maximum length
        for (int i = 0; i < maxLength; i++) {
            // If word1 still has characters at this index, append it
            if (i < word1.length()) {
                result.append(word1.charAt(i));
            }
            // If word2 still has characters at this index, append it
            if (i < word2.length()) {
                result.append(word2.charAt(i));
            }
        }
        
        return result.toString();
    }
}

question 2: Greatest Common Divisor of Strings(lc-1071)
solution: class Solution {
    public String gcdOfStrings(String str1, String str2) {
         if (!(str1 + str2).equals(str2 + str1)) {
            return "";
        }

        // Find GCD of lengths
        int gcd = findGCD(str1.length(), str2.length());

        // Return the common string
        return str1.substring(0, gcd);
    }

    public int findGCD(int a, int b) {

        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }

        return a;
        
    }
}


question 3: Kids With the Greatest Number of Candies(1431)
solution: class Solution {
    public List<Boolean> kidsWithCandies(int[] candies, int extraCandies) {
        List<Boolean> ans = new ArrayList<>();
    final int maxCandy = Arrays.stream(candies).max().getAsInt();

    for (final int candy : candies)
      ans.add(candy + extraCandies >= maxCandy);

    return ans;
    }
}

