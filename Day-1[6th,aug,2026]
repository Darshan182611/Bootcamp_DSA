question 2 sum of prime digits 
solution: class Solution {
    static int primeSum(int n) {
        int sum = 0;

        while (n > 0) {
            int digit = n % 10;
            // The only prime single-digit numbers are 2, 3, 5, and 7
            if (digit == 2 || digit == 3 || digit == 5 || digit == 7) {
                sum += digit;
            }
            n /= 10; 
        }

        return sum;
        
    }
}



