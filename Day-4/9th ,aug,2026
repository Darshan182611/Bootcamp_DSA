question 6 : Inheritance in Java
solution: class Employee {
    int id;
    int salary;

    // Constructor
    public Employee(int id, int salary) {
        this.id = id;
        this.salary = salary;
    }
}

class SalesEmployee extends Employee {
    int sales;

    // Constructor
    public SalesEmployee(int id, int salary, int sales) {
        // Call to the parent class (Employee) constructor
        super(id, salary);
        this.sales = sales;
    }
}

question 7:Design Parking System(lc-1603)
solution: class ParkingSystem {
    // Array to store the available spaces.
    // We use size 4 so we can directly map carType (1, 2, 3) to the indices.
    // Index 0 is ignored.
    private int[] spaces;

    public ParkingSystem(int big, int medium, int small) {
        spaces = new int[]{0, big, medium, small};
    }
    
    public boolean addCar(int carType) {
        // Check if there is an available slot for the given carType
        if (spaces[carType] > 0) {
            spaces[carType]--; // Park the car (decrease available space)
            return true;
        }
        
        // No spaces available for this car type
        return false;
    }
}

