question 4 : Max. area of rec.
solution : class Solution {
    public int calArea(int[][] arr) {
   int maxArea = 0;

   for (int i = 0; i < arr.length; i++) {
       // Area of a rectangle = length * breadth
       int currentArea = arr[i][0] * arr[i][1];

       // Update maxArea if the current rectangle is larger
       if (currentArea > maxArea) {
           maxArea = currentArea;
       }
   }

   return maxArea;
        
    }
}

