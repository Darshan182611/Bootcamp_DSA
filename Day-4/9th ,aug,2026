question 2: Abstraction in Java 
solution : abstract class Shape {
    String color;

    // Constructor
    public Shape(String c) {
        this.color = c;
    }

    // Concrete method
    public String getColor() {
        return color;
    }

    // Abstract method
    public abstract double getArea();
}

class Square extends Shape {
    double side;

    // Constructor
    public Square(String c, double side) {
        super(c);
        this.side = side;
    }

    // Implementing the abstract method
    @Override
    public double getArea() {
        return side * side;
    }
}

